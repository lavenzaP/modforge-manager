<Window
    x:Class="ModForge.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0A0F16" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,10,20,8" Background="#0C121A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="Home" FontSize="22" FontWeight="SemiBold" Foreground="#EEF4FA" />
                <TextBlock x:Name="PageSubtitle" Text="WinUI 3 primary shell candidate." FontSize="13" Foreground="#9AA8B7" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Border Padding="12,5" CornerRadius="14" Background="#0E241C" BorderBrush="#245A46" BorderThickness="1">
                        <TextBlock x:Name="SafetyChip" Text="Safe mode: Dry-run first | No startup scan | Python idle" FontSize="12" FontWeight="SemiBold" Foreground="#3ECF8E" />
                    </Border>
                    <Border Padding="12,5" CornerRadius="14" Background="#10233A" BorderBrush="#25557D" BorderThickness="1">
                        <TextBlock x:Name="StateChip" Text="State: No project" FontSize="12" FontWeight="SemiBold" Foreground="#4F9CFF" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="OpenProjectButton" Content="Open Project" Foreground="#EEF4FA" Background="#111D2A" BorderBrush="#4F9CFF" Click="OpenProjectButton_Click" />
                    <Button x:Name="ScanButton" Content="Scan Mods" Foreground="#EEF4FA" Background="#111D2A" BorderBrush="#3ECF8E" Click="ScanButton_Click" />
                    <Button x:Name="PlanButton" Content="Plan" Foreground="#EEF4FA" Background="#111D2A" BorderBrush="#F5B84B" Click="PlanButton_Click" />
                    <Button x:Name="ApplyButton" Content="Apply to game locked" Foreground="#EEF4FA" Background="#111D2A" BorderBrush="#EF635B" Click="ApplyButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="ShellNav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            Background="#0A0F16"
            Foreground="#EEF4FA"
            SelectionChanged="ShellNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="Home" Tag="Home" Foreground="#EEF4FA" />
                <NavigationViewItem x:Name="NavGuided" Content="Guided Setup" Tag="Guided Setup" Foreground="#EEF4FA" />
                <NavigationViewItem x:Name="NavMods" Content="Mods" Tag="Mods" Foreground="#EEF4FA" />
                <NavigationViewItem x:Name="NavPlan" Content="Plan" Tag="Plan" Foreground="#EEF4FA" />
                <NavigationViewItem x:Name="NavApply" Content="Apply &amp; Restore" Tag="Apply &amp; Restore" Foreground="#EEF4FA" />
                <NavigationViewItem x:Name="NavTools" Content="Tools" Tag="Tools" Foreground="#EEF4FA" />
            </NavigationView.MenuItems>
            <ScrollViewer>
                <Grid x:Name="ContentHost" Padding="18" />
            </ScrollViewer>
        </NavigationView>

        <Grid Grid.Row="2" Padding="24,0" Background="#090E14">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#9AA8B7" FontSize="12" />
        </Grid>
    </Grid>
</Window>
