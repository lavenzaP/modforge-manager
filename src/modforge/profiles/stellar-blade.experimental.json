{
  "schema_version": 1,
  "id": "stellar-blade.experimental",
  "display_name": "Stellar Blade / CNS Experimental",
  "family": "unreal",
  "description": "Experimental Stellar Blade profile for archive-as-is PAK mods, CNS sidecars, SB folder merge packages, and UE4SS runtime files.",
  "root_aliases": {
    "game_root": ".",
    "content_paks": "SB/Content/Paks",
    "mods_paks": "SB/Content/Paks/~mods",
    "binaries_win64": "SB/Binaries/Win64"
  },
  "deployment_rules": [
    {
      "id": "rooted-ue4ss-runtime-folder",
      "source_patterns": ["SB/Binaries/Win64/ue4ss/**", "SB/Binaries/Win64/UE4SS/**"],
      "destination_root": "game_root",
      "destination_pattern": "{relative_path}",
      "priority": -30,
      "mode": "preserve_structure",
      "safety_tier": "runtime-file",
      "requires_extra_confirmation": true
    },
    {
      "id": "runtime-dll-rooted",
      "source_patterns": [
        "SB/Binaries/Win64/dwmapi.dll",
        "SB/Binaries/Win64/UE4SS.dll",
        "SB/Binaries/Win64/xinput*.dll",
        "SB/Binaries/Win64/version.dll"
      ],
      "destination_root": "game_root",
      "destination_pattern": "{relative_path}",
      "priority": -20,
      "safety_tier": "dll-high-risk",
      "requires_extra_confirmation": true
    },
    {
      "id": "existing-sb-layout",
      "source_patterns": ["SB/**"],
      "destination_root": "game_root",
      "destination_pattern": "{relative_path}",
      "priority": 0,
      "mode": "preserve_structure",
      "safety_tier": "archive"
    },
    {
      "id": "ue4ss-runtime-folder",
      "source_patterns": ["ue4ss/**", "UE4SS/**"],
      "destination_root": "binaries_win64",
      "destination_pattern": "{relative_path}",
      "priority": 10,
      "safety_tier": "runtime-file",
      "requires_extra_confirmation": true
    },
    {
      "id": "runtime-dll-root",
      "source_patterns": ["dwmapi.dll", "UE4SS.dll", "xinput*.dll", "version.dll"],
      "destination_root": "binaries_win64",
      "destination_pattern": "{filename}",
      "priority": 20,
      "safety_tier": "dll-high-risk",
      "requires_extra_confirmation": true
    },
    {
      "id": "unreal-archive-to-mods",
      "source_patterns": ["*.pak", "*.ucas", "*.utoc", "**/*.pak", "**/*.ucas", "**/*.utoc"],
      "destination_root": "mods_paks",
      "destination_pattern": "{filename}",
      "priority": 30,
      "mode": "archive_as_is",
      "safety_tier": "archive"
    },
    {
      "id": "cns-json-sidecar",
      "source_patterns": ["*.json", "**/*.json"],
      "destination_root": "mods_paks",
      "destination_pattern": "{filename}",
      "priority": 40,
      "mode": "sidecar",
      "safety_tier": "archive"
    },
    {
      "id": "logicmods-layout",
      "source_patterns": ["LogicMods/**", "SB/Content/Paks/LogicMods/**"],
      "destination_root": "content_paks",
      "destination_pattern": "{relative_path}",
      "priority": 50,
      "mode": "preserve_structure",
      "safety_tier": "archive"
    }
  ],
  "ignored_patterns": ["**/.DS_Store", "**/Thumbs.db", "README*", "*.txt"],
  "supported_containers": ["loose_folder", "zip", "unreal_pak"],
  "sidecar_groups": [
    {
      "id": "unreal-sidecar",
      "extensions": [".pak", ".ucas", ".utoc"],
      "atomic": true,
      "missing_behavior": "warning"
    }
  ],
  "protected_paths": [
    "SB/Binaries/Win64/*.exe",
    "SB/Binaries/Win64/*.dll"
  ],
  "validation_samples": [
    {
      "source": "CoolOutfit_P.pak",
      "expected_destination": "SB/Content/Paks/~mods/CoolOutfit_P.pak"
    },
    {
      "source": "CoolOutfit_P.json",
      "expected_destination": "SB/Content/Paks/~mods/CoolOutfit_P.json"
    },
    {
      "source": "dwmapi.dll",
      "expected_destination": "SB/Binaries/Win64/dwmapi.dll"
    },
    {
      "source": "UE4SS.dll",
      "expected_destination": "SB/Binaries/Win64/UE4SS.dll"
    },
    {
      "source": "SB/Binaries/Win64/ue4ss/Mods/CNS/main.lua",
      "expected_destination": "SB/Binaries/Win64/ue4ss/Mods/CNS/main.lua"
    },
    {
      "source": "SB/Content/Paks/~mods/AlreadyPacked_P.pak",
      "expected_destination": "SB/Content/Paks/~mods/AlreadyPacked_P.pak"
    }
  ]
}
